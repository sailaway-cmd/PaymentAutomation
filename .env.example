# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Path to the Google service account JSON credentials file
GOOGLE_CREDENTIALS_PATH=credentials.json

# ID of the target Google Sheet (from its URL)
GOOGLE_SHEET_ID=

# Worksheet/tab name to write receipts to (optional, defaults to "Sheet1")
GOOGLE_SHEET_WORKSHEET=Sheet1
